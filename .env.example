# ========================================================
# REVIVIO PLATFORM CONFIGURATION ENVIRONMENT VARIABLES
# ========================================================

# Database Settings (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=revivio_db
DB_USERNAME=revivio_user
DB_PASSWORD=revivio_pass

# Security & Authentication (JWT HMAC-SHA256)
# Minimum 256-bit secret key for production environments
JWT_SECRET=revivio-super-secret-key-that-is-at-least-256-bits-long-for-hmac-sha
JWT_EXPIRATION_MS=86400000

# File Storage Configuration
STORAGE_PATH=./uploads

# Frontend API Endpoint (Vite Dev Server)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Spring Profile (dev / prod)
SPRING_PROFILES_ACTIVE=dev
